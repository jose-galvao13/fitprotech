---
/*
  Secção de projetos/portefólio.
  Imagens reais em /public/img: ginasio1.jpg, ginasio2.jpg, ginasio3.jpg
*/
const projetos = [
  { titulo: 'Urban Strength', local: 'Gym Boutique – Coimbra', imagem: '/img/ginasio1.jpg' },
  { titulo: 'MegaFit', local: 'Commercial Gym – Coimbra', imagem: '/img/ginasio2.jpg' },
  { titulo: 'Riverside Hotel', local: 'Hotel Gym – Coimbra', imagem: '/img/ginasio3.jpg' },
];
---

<section class="proj" id="projetos">
  <div class="wrap">
    <span class="olho">PROJETOS</span>
    <h2 class="proj__titulo">Alguns espaços que já equipámos.</h2>

    <div class="proj__grelha">
      {projetos.map((p) => (
        <div class="proj__item">
          <div class="proj__imagem">
            <img src={p.imagem} alt={p.titulo} loading="lazy" />
          </div>
          <strong>{p.titulo}</strong>
          <span class="dado">{p.local}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .proj {
    background: var(--painel);
    padding: 96px 0;
    border-top: 1px solid var(--aco-linha);
  }

  .proj__titulo {
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    margin: 10px 0 48px;
    color: var(--osso);
  }

  .proj__grelha {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .proj__item {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .proj__imagem {
    aspect-ratio: 4 / 3;
    border: 1.5px solid var(--aco-linha);
    overflow: hidden;
    background: var(--painel-2);
    margin-bottom: 6px;
  }

  .proj__imagem img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .proj__item strong {
    font-family: var(--f-corpo);
    font-weight: 600;
    color: var(--osso);
  }

  @media (max-width: 860px) {
    .proj__grelha {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .proj {
      padding: 56px 0;
    }
  }
</style>
