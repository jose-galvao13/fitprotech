---
const ano = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const logoSrc = `${base}/img/Logo-no-background.png`;
---

<footer class="rodape">
  <div class="wrap rodape__linha">
    <div class="rodape__marca">
      <img src={logoSrc} alt="" aria-hidden="true" width="22" height="22" class="rodape__icone" />
    </div>

    <p class="rodape__legal">
      FITPRO TECH — Unipessoal, Lda. · NIPC 518 294 30 · Eiras, 3020-430 Coimbra
    </p>

    <nav aria-label="Redes sociais" class="rodape__social">
      <!-- PLACEHOLDER: substituir "#" pelos links reais das redes sociais quando existirem -->
      <a href="#" aria-label="Instagram">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2c2.72 0 3.06.01 4.12.06 1.06.05 1.79.22 2.43.47.66.26 1.22.6 1.76 1.15.55.54.89 1.1 1.15 1.76.25.64.42 1.37.47 2.43.05 1.06.06 1.4.06 4.12s-.01 3.06-.06 4.12c-.05 1.06-.22 1.79-.47 2.43a4.9 4.9 0 0 1-1.15 1.76 4.9 4.9 0 0 1-1.76 1.15c-.64.25-1.37.42-2.43.47-1.06.05-1.4.06-4.12.06s-3.06-.01-4.12-.06c-1.06-.05-1.79-.22-2.43-.47a4.9 4.9 0 0 1-1.76-1.15 4.9 4.9 0 0 1-1.15-1.76c-.25-.64-.42-1.37-.47-2.43C2.01 15.06 2 14.72 2 12s.01-3.06.06-4.12c.05-1.06.22-1.79.47-2.43.26-.66.6-1.22 1.15-1.76a4.9 4.9 0 0 1 1.76-1.15c.64-.25 1.37-.42 2.43-.47C8.94 2.01 9.28 2 12 2zm0 1.8c-2.67 0-2.99.01-4.04.06-.86.04-1.32.18-1.63.3-.41.16-.7.35-1.01.66-.31.31-.5.6-.66 1.01-.12.31-.26.77-.3 1.63C4.31 9.01 4.3 9.33 4.3 12s.01 2.99.06 4.04c.04.86.18 1.32.3 1.63.16.41.35.7.66 1.01.31.31.6.5 1.01.66.31.12.77.26 1.63.3 1.05.05 1.37.06 4.04.06s2.99-.01 4.04-.06c.86-.04 1.32-.18 1.63-.3.41-.16.7-.35 1.01-.66.31-.31.5-.6.66-1.01.12-.31.26-.77.3-1.63.05-1.05.06-1.37.06-4.04s-.01-2.99-.06-4.04c-.04-.86-.18-1.32-.3-1.63a2.7 2.7 0 0 0-.66-1.01 2.7 2.7 0 0 0-1.01-.66c-.31-.12-.77-.26-1.63-.3C14.99 3.81 14.67 3.8 12 3.8zm0 3.05a5.15 5.15 0 1 1 0 10.3 5.15 5.15 0 0 1 0-10.3zm0 1.8a3.35 3.35 0 1 0 0 6.7 3.35 3.35 0 0 0 0-6.7zm5.53-2.9a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4z"/>
        </svg>
      </a>
      <a href="#" aria-label="Facebook">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M13.5 21v-7.6h2.55l.4-2.95h-2.95V8.4c0-.85.24-1.44 1.46-1.44h1.56V4.33C15.98 4.21 15 4.13 13.85 4.13c-2.32 0-3.91 1.41-3.91 4v2.32H7.38v2.95H9.94V21h3.56z"/>
        </svg>
      </a>
    </nav>
  </div>

  <div class="wrap rodape__base">
    <span>© {ano} FITPRO TECH. Todos os direitos reservados.</span>
  </div>
</footer>

<style>
  .rodape {
    background: var(--preto);
    color: var(--aco);
    border-top: 1px solid var(--aco-linha);
  }

  .rodape__linha {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    padding: 40px 24px 24px;
  }

  .rodape__marca {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--f-display);
    font-weight: 700;
    color: var(--osso);
    font-size: 1.05rem;
  }

  .rodape__icone {
     height: 42px;
    width: auto;
    display: block;
  }

  .rodape__legal {
    font-family: var(--f-tecnico);
    font-size: 0.78rem;
    color: var(--aco);
  }

  .rodape__social {
    display: flex;
    gap: 16px;
    align-items: center;
  }
  .rodape__social a {
    display: flex;
    color: var(--osso);
    opacity: 0.85;
    transition: opacity 0.2s ease, color 0.2s ease;
  }
  .rodape__social a svg {
    width: 20px;
    height: 20px;
  }
  .rodape__social a:hover {
    color: var(--vermelho-luz);
    opacity: 1;
  }

  .rodape__base {
    border-top: 1px solid var(--aco-linha);
    padding: 18px 24px;
    font-size: 0.78rem;
  }
</style>
