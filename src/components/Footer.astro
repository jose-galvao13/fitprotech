---
const ano = new Date().getFullYear();
---

<footer class="rodape">
  <div class="wrap rodape__linha">
    <div class="rodape__marca">
      <svg viewBox="0 0 40 40" aria-hidden="true" width="22" height="22">
        <polygon points="0,4 16,20 0,36 8,36 24,20 8,4" fill="#c41e2e" />
        <polygon points="14,4 30,20 14,36 22,36 38,20 22,4" fill="#4b4e54" />
      </svg>
      <span>FITPRO TECH</span>
    </div>

    <p class="rodape__legal">
      FITPRO TECH — Unipessoal, Lda. · NIPC 518 294 30 · Eiras, 3020-430 Coimbra
    </p>

    <nav aria-label="Redes sociais" class="rodape__social">
      <!-- PLACEHOLDER: substituir "#" pelos links reais das redes sociais quando existirem -->
      <a href="#" aria-label="Instagram">Instagram</a>
      <a href="#" aria-label="Facebook">Facebook</a>
    </nav>
  </div>

  <div class="wrap rodape__base">
    <span>© {ano} FITPRO TECH. Todos os direitos reservados.</span>
  </div>
</footer>

<style>
  .rodape {
    background: var(--preto);
    color: var(--aco);
    border-top: 1px solid var(--aco-linha);
  }

  .rodape__linha {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    padding: 40px 24px 24px;
  }

  .rodape__marca {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--f-display);
    font-weight: 700;
    color: var(--osso);
    font-size: 1.05rem;
  }

  .rodape__legal {
    font-family: var(--f-tecnico);
    font-size: 0.78rem;
    color: var(--aco);
  }

  .rodape__social {
    display: flex;
    gap: 18px;
  }
  .rodape__social a {
    font-size: 0.85rem;
    color: var(--prata);
  }
  .rodape__social a:hover {
    color: var(--vermelho-luz);
  }

  .rodape__base {
    border-top: 1px solid var(--aco-linha);
    padding: 18px 24px;
    font-size: 0.78rem;
  }
</style>
