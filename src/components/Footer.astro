---
const ano = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const logoSrc = `${base}/img/Logo-no-background.png`;
---

<footer class="rodape">
  <div class="wrap rodape__linha">
    <div class="rodape__marca">
      <img src={logoSrc} alt="" aria-hidden="true" width="22" height="22" class="rodape__icone" />
    </div>

    <p class="rodape__legal">
      FITPRO TECH — Unipessoal, Lda. · NIPC 518 294 30 · Eiras, 3020-430 Coimbra
    </p>

    <nav aria-label="Redes sociais" class="rodape__social">
      <!-- PLACEHOLDER: substituir "#" pelos links reais das redes sociais quando existirem -->
      <a href="#" aria-label="Instagram">Instagram</a>
      <a href="#" aria-label="Facebook">Facebook</a>
    </nav>
  </div>

  <div class="wrap rodape__base">
    <span>© {ano} FITPRO TECH. Todos os direitos reservados.</span>
  </div>
</footer>

<style>
  .rodape {
    background: var(--preto);
    color: var(--aco);
    border-top: 1px solid var(--aco-linha);
  }

  .rodape__linha {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    padding: 40px 24px 24px;
  }

  .rodape__marca {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--f-display);
    font-weight: 700;
    color: var(--osso);
    font-size: 1.05rem;
  }

  .rodape__icone {
    border-radius: 3px;
    object-fit: cover;
  }

  .rodape__legal {
    font-family: var(--f-tecnico);
    font-size: 0.78rem;
    color: var(--aco);
  }

  .rodape__social {
    display: flex;
    gap: 18px;
  }
  .rodape__social a {
    font-size: 0.85rem;
    color: var(--prata);
  }
  .rodape__social a:hover {
    color: var(--vermelho-luz);
  }

  .rodape__base {
    border-top: 1px solid var(--aco-linha);
    padding: 18px 24px;
    font-size: 0.78rem;
  }
</style>
